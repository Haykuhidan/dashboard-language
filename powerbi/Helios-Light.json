{
  "name": "Helios Light",
  "dataColors": [
    "#2F80ED",
    "#14857F",
    "#8B44D1",
    "#C2610F",
    "#5B6672",
    "#FFCD11",
    "#1E8449",
    "#C93C3C"
  ],
  "background": "#FFFFFF",
  "foreground": "#111820",
  "tableAccent": "#FFCD11",
  "good": "#1E8449",
  "neutral": "#C2610F",
  "bad": "#C93C3C",
  "maximum": "#2F80ED",
  "center": "#F8FAFC",
  "minimum": "#FFFFFF",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#111820"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#111820"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#111820"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#4F5B67"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D3DAE2"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#111820"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "fontSize": 9,
            "titleColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "fontSize": 9,
            "titleColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#111820"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#111820"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "gridVertical": false,
            "rowPadding": 6,
            "outlineColor": {
              "solid": {
                "color": "#D3DAE2"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#111820"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#111820"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#111820"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#D3DAE2"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#111820"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#111820"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#111820"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#111820"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#4F5B67"
              }
            },
            "textSize": 9
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}