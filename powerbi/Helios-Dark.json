            },
            "backColor": {
              "solid": {
                "color": "#18222D"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#18222D"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#18222D"
              }
            },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F2B38"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#243140"
              }
            },
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#334250"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#9AA7B4"
              }
            },
            "backColor": {
              "solid": {
                "color": "#18222D"
              }
            },
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "backColor": {
              "solid": {
                "color": "#18222D"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#18222D"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#18222D"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EBF0"
              }
            },
            "background": {
              "solid": {
                "color": "#18222D"
              }
            },
            "textSize": 10
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#9AA7B4"
              }
            },
            "textSize": 9
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
