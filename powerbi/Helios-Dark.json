            "gridVertical": false,
            "rowPadding": 6,
            "outlineColor": {
              "solid": {
                "color": "#334250"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#9AA7B4"
